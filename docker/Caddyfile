# 운영 리버스 프록시와 자동 HTTPS (M6 커밋 6, ADR-030). 값은 compose가 환경변수로 넣는다(DOMAIN, ACME_EMAIL).
# 배포 전에 서버에서 문법을 확인한다: docker compose ... run --rm caddy caddy validate --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}

	# 접근 로그 밖의 로그(앱이 응답하지 않을 때의 프록시 오류 등)에도 요청 주소·Referer가 들어간다. 같은 규칙으로 가린다
	log default {
		output stdout
		format filter {
			wrap json
			request>uri regexp ^/t/[^/?#]+ /t/***
			request>headers>Referer regexp /t/[^/?#]+ /t/***
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# 헬스체크·관리 주소는 밖에서 열지 않는다 (PRD 7.3). 컨테이너 안의 헬스체크는 직접 8080으로 간다
	@actuator path /actuator /actuator/*
	respond @actuator 404

	# 앱으로 넘긴다. Caddy는 밖에서 온 X-Forwarded-*를 믿지 않고 실제 접속 IP와 https를 새로 적어 넘긴다
	reverse_proxy app:8080

	# 접근 로그: 세입자 링크 토큰을 가린다 (출시 전 필수, M4 결정 9). /t/{토큰}은 경로와 Referer 헤더 모두에 들어간다.
	# 쿠키·인증 헤더는 지운다. 배포 뒤 실제 로그에서 토큰이 보이지 않는지 꼭 확인한다(runbook "Caddy 로그 확인")
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp ^/t/[^/?#]+ /t/***
			request>headers>Referer regexp /t/[^/?#]+ /t/***
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}
