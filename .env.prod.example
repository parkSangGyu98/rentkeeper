# 운영 서버의 환경변수 (M6). 이 파일을 서버에서 .env.prod로 복사하고 값을 채운다(권한 600, git에 올리지 않는다).
# 값은 비워 두었다. 만드는 방법은 docs/deploy-checklist.md 5단계. 빠진 필수 값이 있으면 앱이나 compose가 기동하지 않는다.
# 각 이름은 한 번씩만 나온다.

# ---------------------------------------------------------------- compose (docker/compose.prod.yml)
# 서비스 도메인 (예: rentkeeper.example.com, https:// 없이). Caddy가 이 이름으로 인증서를 받는다
DOMAIN=
# 인증서(Let's Encrypt) 만료 안내를 받을 메일 주소
ACME_EMAIL=
# 실행할 앱 이미지와 태그 (예: ghcr.io/계정/rentkeeper:v0.6.0). latest 대신 버전 태그를 쓴다
APP_IMAGE=
# JVM 메모리 설정. 비우면 compose 기본값(힙 640MB)을 쓴다
JAVA_TOOL_OPTIONS=

# ---------------------------------------------------------------- 데이터베이스
# DB 이름·사용자·비밀번호. postgres 컨테이너가 처음 뜰 때 이 값으로 만든다(나중에 바꾸려면 DB에서 직접 바꿔야 한다)
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------- 앱 주소
# 사용자가 실제로 여는 주소 (예: https://rentkeeper.example.com, 끝에 / 없이). 메일 링크·세입자 링크·Origin 검사에 쓴다
APP_BASE_URL=

# ---------------------------------------------------------------- 키 (잃으면 복구할 수 없다. 비밀번호 관리자와 오프라인 사본에 따로 보관)
# 로그인 유지(remember-me) 키, 32자 이상
APP_REMEMBER_ME_KEY=
# 개인정보 암호화 키 (Base64, 32바이트)와 키 버전(처음은 1). 잃으면 세입자 이름·연락처·계좌를 복구할 수 없다
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=
# 키를 바꿀 때만: 예전 키들 "버전:키" (쉼표로 구분). 처음에는 비워 둔다
APP_ENCRYPTION_PREVIOUS_KEYS=
# 전화번호 해시 키 (Base64, 32바이트)
APP_HMAC_KEY=

# ---------------------------------------------------------------- 카카오 로그인 (운영 필수)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=

# ---------------------------------------------------------------- 메일 (Brevo SMTP 등)
MAIL_HOST=
# 비우면 587(STARTTLS)
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# 보내는 사람 (예: RentKeeper <no-reply@도메인>). 메일 업체에서 도메인 인증(SPF·DKIM)을 마친 주소
MAIL_FROM=
# 운영 알림(배치 실패 등)을 받을 내 메일 주소 (운영 필수)
OPS_ALERT_EMAIL=

# ---------------------------------------------------------------- 공개 접근 (M6 결정 3)
# 초대 코드, 16자 이상 (운영 필수). 가입하려면 이 코드를 넣어야 한다
APP_SIGNUP_INVITE_CODE=
# 첫 화면의 [데모로 둘러보기] 켜기 (true/false)
APP_DEMO_ENABLED=
# 동시에 있을 수 있는 데모 계정 수 (비우면 50)
APP_DEMO_MAX_ACCOUNTS=
# 데모 계정을 지우기까지의 시간 (비우면 24h)
APP_DEMO_LIFETIME=

# ---------------------------------------------------------------- 세입자 안내 문자 (문자 대행사가 없으므로 false 그대로)
APP_NOTIFICATION_TENANT_PHONE_ENABLED=false

# ---------------------------------------------------------------- 백업 (scripts/backup.sh, Cloudflare R2 등 S3 호환 저장소)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# 백업 파일 암호 (gpg). 잃으면 백업을 풀 수 없다. 암호화 키와 함께 따로 보관
BACKUP_PASSPHRASE=
