# 로컬 개발용 환경변수 예시. 복사해서 사용: Copy-Item .env.example .env
# 실제 .env는 git에 올리지 않는다 (.gitignore). 이후 마일스톤에서 필요한 변수를 추가한다 (PRD 13장).
# 운영 프로필은 OS 환경변수 SPRING_PROFILES_ACTIVE=prod로 지정한다 (로컬은 기본값 local).

# docker compose와 Spring(application-local.yml이 이 파일을 import)이 함께 사용
DB_NAME=rentkeeper
DB_PORT=5432
DB_USER=rentkeeper
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/rentkeeper
