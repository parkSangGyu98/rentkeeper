# 로컬 개발용 환경변수 예시. 복사해서 사용: Copy-Item .env.example .env
# 실제 .env는 git에 올리지 않는다 (.gitignore). 이후 마일스톤에서 필요한 변수를 추가한다 (PRD 13장).
# 운영 프로필은 OS 환경변수 SPRING_PROFILES_ACTIVE=prod로 지정한다 (로컬은 기본값 local).

# docker compose와 Spring(application-local.yml이 이 파일을 import)이 함께 사용
DB_NAME=rentkeeper
DB_PORT=5432
DB_USER=rentkeeper
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/rentkeeper

# 로그인 유지(remember-me) 키 (ADR-013). 값은 직접 만들어 넣는다. 운영에서는 필수(32자 이상).
# local에서 비워 두면 앱을 켤 때마다 임시 키를 쓴다.
# 만드는 법 (PowerShell 5.1, 암호학적으로 안전한 난수 32바이트):
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# 주의: PersistentToken 방식이라 키를 바꿔도 기존 로그인 유지는 풀리지 않는다.
#       모든 기기의 로그인 유지를 끊으려면 persistent_logins 테이블을 비운다.
APP_REMEMBER_ME_KEY=

# 카카오 로그인 (ADR-014). 값은 카카오 개발자 콘솔에서 확인해 직접 넣는다. 절대 커밋하지 않는다.
# 셋 다 비우면 local에서는 카카오 로그인이 꺼진다(버튼 숨김). 일부만 넣으면 앱이 뜨지 않는다. 운영에서는 셋 다 필수.
# KAKAO_CLIENT_ID: 앱 키 > REST API 키
# KAKAO_CLIENT_SECRET: 카카오 로그인 > 보안 > 클라이언트 시크릿 (코드)
# KAKAO_ADMIN_KEY: 앱 키 > 어드민 키 (탈퇴 시 연결 끊기에 사용, 서버에서만 사용)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=

# 운영자 알림 메일 받을 주소 (카카오 연결 끊기 실패 등, 하루 한 통 요약, 개인정보 없이 건수만).
# 운영 메일 발송이 생기는 M5부터 쓴다. 그 전에는 비워 두면 되고, 알림은 ERROR 로그(rentkeeper.ops-alert)로만 남는다.
# 운영 필수로 할지는 M5 이후에 정한다.
OPS_ALERT_EMAIL=
